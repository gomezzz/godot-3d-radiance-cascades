// Analytic scene data is shared by every cascade; t stays in world units
// even when an object's inverse transform includes nonuniform scaling.
struct Primitive {
    mat4 world_to_local;
    vec4 shape;
    vec4 albedo;
    vec4 emission;
};
layout(set=0, binding=0, std430) readonly buffer Scene { Primitive objects[]; };
layout(set=0, binding=3, rgba16f) uniform readonly image2D history_tex;
layout(push_constant, std430) uniform Params {
    vec4 origin_spacing;
    ivec4 grid_level;
    ivec4 upper_grid_objects;
    vec4 interval_bounce_blend;
    ivec4 base_grid_enabled;
    vec4 sky;
} pc;
const float PI = 3.141592653589793;
ivec3 decode_probe(int index, ivec3 grid) {
    return ivec3(index % grid.x, (index / grid.x) % grid.y, index / (grid.x * grid.y));
}
int probe_index(ivec3 p, ivec3 grid) { return p.x + grid.x * (p.y + grid.y * p.z); }
// Equal solid-angle bins: longitude and cos(polar angle). Four children
// exactly partition a parent's solid angle, so their merge weights are 1/4.
vec3 direction_at(ivec2 cell, ivec2 angular) {
    float phi = (float(cell.x) + 0.5) / float(angular.x) * 2.0 * PI;
    float y = 1.0 - 2.0 * (float(cell.y) + 0.5) / float(angular.y);
    float r = sqrt(max(0.0, 1.0 - y * y));
    return vec3(cos(phi) * r, y, sin(phi) * r);
}
ivec2 atlas_coord(ivec3 p, int face) {
    ivec3 grid = pc.base_grid_enabled.xyz;
    return ivec2(p.x + face * grid.x, p.y + p.z * grid.y);
}
vec3 axis_direction(int face) {
    vec3 n = vec3(0.0);
    n[face / 2] = (face % 2 == 0) ? 1.0 : -1.0;
    return n;
}
vec3 history_irradiance(vec3 position, vec3 normal) {
    ivec3 grid = pc.base_grid_enabled.xyz;
    vec3 q = clamp((position - pc.origin_spacing.xyz) / 0.5 - 0.5,
                   vec3(0.0), vec3(grid - 1));
    ivec3 p = ivec3(floor(q));
    vec3 f = fract(q), result = vec3(0.0);
    for (int corner = 0; corner < 8; ++corner) {
        ivec3 offset = ivec3(corner & 1, (corner >> 1) & 1, (corner >> 2) & 1);
        ivec3 cell = min(p + offset, grid - 1);
        vec3 w = mix(1.0 - f, f, vec3(offset));
        vec3 sample_value = vec3(0.0);
        for (int axis = 0; axis < 3; ++axis) {
            int face = axis * 2 + ((normal[axis] < 0.0) ? 1 : 0);
            sample_value += imageLoad(history_tex, atlas_coord(cell, face)).rgb
                            * normal[axis] * normal[axis];
        }
        result += sample_value * w.x * w.y * w.z;
    }
    return result;
}
bool intersect_object(Primitive object, vec3 ro, vec3 rd, float limit,
                      out float t, out vec3 normal) {
    vec3 o = (object.world_to_local * vec4(ro, 1.0)).xyz;
    vec3 d = (object.world_to_local * vec4(rd, 0.0)).xyz;
    vec3 local_normal;
    if (object.shape.w > 0.5) {
        float a = dot(d, d), b = dot(o, d);
        float c = dot(o, o) - object.shape.x * object.shape.x;
        float discriminant = b*b - a*c;
        if (discriminant < 0.0) return false;
        float near_t = (-b - sqrt(discriminant)) / a;
        float far_t = (-b + sqrt(discriminant)) / a;
        if (far_t < 0.0) return false;
        t = max(0.0, near_t);
        local_normal = normalize(o + d * t);
    } else {
        vec3 half_size = object.shape.xyz * 0.5;
        float near_t = -1e20, far_t = 1e20;
        int hit_axis = 0;
        for (int axis = 0; axis < 3; ++axis) {
            if (abs(d[axis]) < 1e-7) {
                if (abs(o[axis]) > half_size[axis]) return false;
            } else {
                float a = (-half_size[axis] - o[axis]) / d[axis];
                float b = (half_size[axis] - o[axis]) / d[axis];
                float entry = min(a, b);
                if (entry > near_t) { near_t = entry; hit_axis = axis; }
                far_t = min(far_t, max(a, b));
            }
        }
        if (near_t > far_t || far_t < 0.0) return false;
        t = max(0.0, near_t);
        local_normal = vec3(0.0);
        local_normal[hit_axis] = -sign(d[hit_axis]);
    }
    if (t >= limit) return false;
    normal = normalize(transpose(mat3(object.world_to_local)) * local_normal);
    return true;
}
vec4 trace_interval(vec3 origin, vec3 direction) {
    float start = pc.interval_bounce_blend.x, end = pc.interval_bounce_blend.y;
    vec3 ro = origin + direction * start;
    float closest = end - start;
    int hit = -1;
    vec3 hit_normal = vec3(0.0);
    for (int i = 0; i < pc.upper_grid_objects.w; ++i) {
        float t; vec3 normal;
        if (intersect_object(objects[i], ro, direction, closest, t, normal)) {
            closest = t; hit = i; hit_normal = normal;
        }
    }
    if (hit < 0) return vec4(0.0, 0.0, 0.0, 1.0);
    // An interval beginning inside a solid is opaque, not an interior emitter.
    if (closest < 0.0001) return vec4(0.0);
    vec3 radiance = objects[hit].emission.rgb;
    if (pc.interval_bounce_blend.z > 0.0) {
        vec3 p = ro + direction * closest + hit_normal * 0.3;
        radiance += objects[hit].albedo.rgb * history_irradiance(p, hit_normal)
                    * pc.interval_bounce_blend.z;
    }
    return vec4(radiance, 0.0);
}
